#!/bin/sh
# Connects TouchGlass to gpg-agent, disconnects it again, and reports its state.
# Run `scripts/touchglass help` for usage.
#
# gpg-agent.conf names two launchers in ~/Library/Application Support/TouchGlass/bin instead of the
# helpers in TouchGlass.app. Each launcher runs the helper from the app, or, while the app is missing
# (during `brew upgrade`, or after it was deleted), the plain pinentry or the real scdaemon.
#
# By default, install and uninstall write only TouchGlass's own files and print the gpg-agent.conf
# change for you to make. With --apply they edit gpg-agent.conf themselves, and only its
# pinentry-program and scdaemon-program lines: install comments out the effective line with a
# "# touchglass: " prefix and adds the TouchGlass line right after it, or, if the option is not set,
# adds a "# touchglass: added <option>" marker and the TouchGlass line at the end of the file. The
# printed instructions describe the same markers. gpg-agent uses the last occurrence of an option, so
# earlier duplicates stay as they are. Uninstall reverses exactly these edits, so the rest of the file
# stays byte-identical.
set -eu
# Byte-wise text handling: awk in a UTF-8 locale stops at a byte that isn't valid UTF-8, such as a
# Latin-1 character in a comment.
export LC_ALL=C

prog=touchglass
# scripts/build-app.sh replaces "dev" with the release version in the copy it bundles.
cli_version=dev
marker='# touchglass: '
gnupg_home="${GNUPGHOME:-$HOME/.gnupg}"
conf="$gnupg_home/gpg-agent.conf"
support_dir="$HOME/Library/Application Support/TouchGlass"
scd_path_file="$support_dir/scdaemon-program"
pinentry_conf="$support_dir/pinentry.conf"
# Every gpg-agent.conf that install was run for, one path per line. The launchers serve every GnuPG
# home, so uninstall keeps them while any of these files names them.
confs_file="$support_dir/gpg-agent-confs"
# The launchers that gpg-agent.conf names, and a copy of this script that outlives the app.
bin_dir="$support_dir/bin"
launch_pinentry="$bin_dir/touchglass-pinentry"
launch_scd="$bin_dir/touchglass-scdaemon"
cli_copy="$bin_dir/touchglass"
# Where install looks for pinentry-mac besides PATH, and where the pinentry launcher looks for
# pinentry-mac, then pinentry, when pinentry.conf names no executable fallback. The tests point it at
# their sandbox.
pinentry_mac_dirs="${TOUCHGLASS_PINENTRY_MAC_DIRS:-/opt/homebrew/bin /usr/local/bin}"

# The app that a launcher runs, read back from the `app='...'` line that install wrote.
launcher_app() { # launcher
    [ -f "$1" ] || return 0
    sed -n "s/^app='\(.*\)'\$/\1/p" "$1" | sed "s/'\\\\''/'/g" | head -n 1
}

# Where this script lives, with symlinks resolved: the formula's command in Homebrew's bin directory
# runs the copy in TouchGlass.app, and a symlink to that copy works too. Inside a bundle, the script
# works on that bundle; as the copy in the support directory, on the app the launchers run; in a
# checkout, on the repository.
self="$(realpath "$0")"
self_dir="$(cd "$(dirname "$self")" && pwd -P)"
bundle_app=""
repo_root=""
case "$self_dir" in
    */*.app/Contents/Resources)
        if [ -x "$self_dir/../MacOS/TouchGlass" ]; then bundle_app="${self_dir%/Contents/Resources}"; fi
        ;;
esac
# Homebrew formulae live in a versioned Cellar directory that an upgrade deletes; prefer the stable
# opt link to the same keg, so the launchers keep pointing at the installed version.
stable_app() { # path
    case "$1" in
        */Cellar/*/*/*)
            prefix="${1%%/Cellar/*}"
            rest="${1#"$prefix"/Cellar/}"
            name="${rest%%/*}"
            rest="${rest#*/}"
            rest="${rest#*/}"
            if [ "$( (cd "$prefix/opt/$name/$rest" 2>/dev/null && pwd -P) || true)" = "$(cd "$1" && pwd -P)" ]; then
                printf '%s\n' "$prefix/opt/$name/$rest"
                return 0
            fi
            ;;
    esac
    printf '%s\n' "$1"
}
if [ -n "$bundle_app" ]; then bundle_app="$(stable_app "$bundle_app")"; fi
if [ -z "$bundle_app" ] && [ "$self_dir" = "$( (cd "$bin_dir" 2>/dev/null && pwd -P) || true)" ]; then
    recorded="$(launcher_app "$launch_pinentry")"
    if [ -n "$recorded" ] && [ -x "$recorded/Contents/MacOS/TouchGlass" ]; then bundle_app="$recorded"; fi
elif [ -z "$bundle_app" ]; then
    repo_root="$(cd "$self_dir/.." && pwd)"
fi
# The app that uninstall and status look at when gpg-agent.conf and the launchers name none.
default_app="${bundle_app:-$HOME/Applications/TouchGlass.app}"
# Becomes 1 when a step fails after gpg-agent.conf was written; the script then exits with status 1.
exit_status=0

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
warn() { printf '%s: warning: %s\n' "$prog" "$*" >&2; }

usage() {
    cat <<'EOF'
Usage:
  touchglass install [--apply] [--app-dir DIR] [--from APP] [--dry-run]
  touchglass uninstall [--apply] [--remove-app] [--dry-run]
  touchglass uninstall --check
  touchglass status
  touchglass --version

install    Sets up ~/Library/Application Support/TouchGlass: the launchers that
           gpg-agent runs as pinentry-program and scdaemon-program, the real
           scdaemon path, pinentry.conf, and a copy of this command. Then prints
           the two lines to put in gpg-agent.conf and how to restart gpg-agent.
           Run from a checkout, it copies the app to DIR (default ~/Applications),
           building it first if needed. Run from inside TouchGlass.app, as the
           Homebrew command is, it uses that app where it is, unless --app-dir or
           --from is given. --from APP uses an already built TouchGlass.app.
           --apply also edits gpg-agent.conf, after backing it up, and stops
           gpg-agent so that it reads the change; the next card operation asks for
           the PIN again. When --apply replaces the app, it also quits the running
           host and stops scdaemon so that the new helpers take over.
uninstall  Prints how to restore the original pinentry-program and
           scdaemon-program lines. While gpg-agent.conf names the launchers, it
           keeps them; after that, it removes them, unless a gpg-agent that
           started before the change still runs or another GnuPG home's
           gpg-agent.conf names them. --apply restores the lines itself, stops
           gpg-agent and removes the launchers. --remove-app also deletes the
           installed TouchGlass.app after gpg-agent.conf no longer names it;
           for an app that Homebrew installed, run `brew uninstall touchglass`
           instead. Keeps the gpg-agent.conf backups and the settings in
           ~/Library/Application Support/TouchGlass.
           --check exits with status 1 while gpg-agent.conf or the launchers
           still refer to TouchGlass, to check before you delete TouchGlass's
           files.
status     Shows what gpg-agent.conf points at, where the launchers lead and
           whether the host and the scdaemon proxy run.

--dry-run prints what would change, including gpg-agent.conf as a diff, and writes nothing.
GNUPGHOME selects the GnuPG home directory (default ~/.gnupg).
EOF
}

# Shared awk helpers: option name and value of a gpg-agent.conf line, and whether a value is ours.
awk_lib='
function keyof(line,   t) {
    t = line; sub(/^[ \t]+/, "", t)
    if (t ~ /^pinentry-program([ \t\r]|$)/) return "pinentry-program"
    if (t ~ /^scdaemon-program([ \t\r]|$)/) return "scdaemon-program"
    return ""
}
function valof(line,   t) {
    t = line; sub(/^[ \t]*[a-z-]+/, "", t); sub(/^[ \t]+/, "", t); sub(/[ \t\r]+$/, "", t)
    if (t ~ /^".*"$/) t = substr(t, 2, length(t) - 2)
    return t
}
function ours(line, k,   v) {
    v = valof(line)
    return (k == "pinentry-program" && v ~ /\/touchglass-pinentry$/) || (k == "scdaemon-program" && v ~ /\/touchglass-scdaemon$/)
}
function out(s) { if (nout++) printf "\n"; printf "%s", s }
'

# Prints "1" if the file does not end with a newline. An empty file counts as ending with one.
no_eol() {
    if [ -s "$1" ] && [ -n "$(tail -c 1 "$1")" ]; then echo 1; else echo 0; fi
}

# Prints the value the option had before TouchGlass: from a marker, else from the last line that isn't ours.
previous_value() { # file key
    [ -f "$1" ] || return 0
    TG_KEY="$2" awk "$awk_lib"'
    { L[NR] = $0 }
    END {
        k = ENVIRON["TG_KEY"]; found = ""
        for (i = 1; i <= NR; i++) {
            if (index(L[i], "# touchglass: ") == 1) {
                body = substr(L[i], 15)
                if (keyof(body) == k) { print valof(body); exit }
                if (body == "added " k) exit
                continue
            }
            if (keyof(L[i]) == k && !ours(L[i], k)) found = valof(L[i])
        }
        if (found != "") print found
    }' "$1"
}

# Prints the value of the last line for the option, whoever wrote it.
current_value() { # file key
    [ -f "$1" ] || return 0
    TG_KEY="$2" awk "$awk_lib"'
    keyof($0) == ENVIRON["TG_KEY"] { v = valof($0) }
    END { if (v != "") print v }' "$1"
}

# True if the file holds a TouchGlass marker or a line that points at a TouchGlass helper.
touched() { # file
    [ -f "$1" ] || return 1
    awk "$awk_lib"'
    index($0, "# touchglass: ") == 1 { t = 1 }
    { k = keyof($0); if (k != "" && ours($0, k)) t = 1 }
    END { exit t ? 0 : 1 }' "$1"
}

newest_backup() {
    # Backup names end in a sortable timestamp; print the last one.
    ls -1 "$conf".touchglass-backup-* 2>/dev/null | LC_ALL=C sort | tail -n 1
}

# The scdaemon that gpgconf knows about. Homebrew reports a versioned Cellar path that disappears on
# upgrade, so prefer the stable prefix path when it resolves to the same file.
gpgconf_scdaemon() {
    command -v gpgconf >/dev/null 2>&1 || return 0
    path="$(gpgconf --list-components 2>/dev/null | awk -F: '$1 == "scdaemon" { print $3; exit }' | sed 's/%3[aA]/:/g')"
    [ -n "$path" ] || return 0
    case "$path" in
        */Cellar/*)
            prefix="${path%%/Cellar/*}"
            for stable in "$prefix/libexec/scdaemon" "$prefix/opt/gnupg/libexec/scdaemon"; do
                if [ -x "$stable" ] && [ "$(realpath "$stable" 2>/dev/null)" = "$(realpath "$path" 2>/dev/null)" ]; then
                    path="$stable"; break
                fi
            done
            ;;
    esac
    printf '%s\n' "$path"
}

# The pinentries the pinentry launcher tries when pinentry.conf names no executable fallback, in order.
default_fallbacks() {
    for name in pinentry-mac pinentry; do
        for dir in $pinentry_mac_dirs; do printf '%s\n' "$dir/$name"; done
    done
}

default_fallbacks_quoted() {
    default_fallbacks | while IFS= read -r path; do printf ' %s' "$(shq "$path")"; done
}

# The pinentry that the pinentry launcher runs while TouchGlass.app is missing, or nothing.
effective_fallback() {
    configured="$(pinentry_setting fallback-pinentry)"
    if [ -n "$configured" ] && [ -x "$configured" ]; then printf '%s\n' "$configured"; return 0; fi
    default_fallbacks | while IFS= read -r path; do
        if [ -x "$path" ]; then printf '%s\n' "$path"; break; fi
    done
}

find_pinentry_mac() {
    p="$(command -v pinentry-mac 2>/dev/null || true)"
    if [ -n "$p" ] && [ -x "$p" ]; then printf '%s\n' "$p"; return 0; fi
    for dir in $pinentry_mac_dirs; do
        if [ -x "$dir/pinentry-mac" ]; then printf '%s\n' "$dir/pinentry-mac"; return 0; fi
    done
}

# The pinentry that gpgconf reports, which gpg-agent uses when gpg-agent.conf names none.
gpgconf_pinentry() {
    command -v gpgconf >/dev/null 2>&1 || return 0
    path="$(gpgconf --list-components 2>/dev/null | awk -F: '$1 == "pinentry" { print $3; exit }' | sed 's/%3[aA]/:/g')"
    if [ -n "$path" ] && [ -x "$path" ]; then printf '%s\n' "$path"; fi
}

# The installed app's path: the app the launchers run when gpg-agent.conf names them, else the app
# whose helper gpg-agent.conf names directly.
app_from_conf() {
    v="$(current_value "$conf" pinentry-program)"
    case "$v" in
        "$launch_pinentry") launcher_app "$launch_pinentry" ;;
        */Contents/MacOS/touchglass-pinentry) printf '%s\n' "${v%/Contents/MacOS/touchglass-pinentry}" ;;
    esac
}

# How gpg-agent.conf uses TouchGlass: "launchers", "direct" (the helpers in an app, as installs before
# the launchers did), "mixed", or "none".
conf_mode() {
    p="$(current_value "$conf" pinentry-program)"
    s="$(current_value "$conf" scdaemon-program)"
    mode_of() { # value helper-name launcher
        case "$1" in
            "$3") echo launchers ;;
            */"$2") echo direct ;;
            *) echo none ;;
        esac
    }
    mp="$(mode_of "$p" touchglass-pinentry "$launch_pinentry")"
    ms="$(mode_of "$s" touchglass-scdaemon "$launch_scd")"
    if [ "$mp" = "$ms" ]; then echo "$mp"; else echo mixed; fi
}

# True if a line of gpg-agent.conf that isn't commented out names a TouchGlass helper or launcher.
conf_refers() {
    [ -f "$conf" ] || return 1
    awk "$awk_lib"'
    { k = keyof($0); if (k != "" && ours($0, k)) t = 1 }
    END { exit t ? 0 : 1 }' "$conf"
}

# Quotes a string for sh: wraps it in single quotes and escapes the single quotes inside.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Prints a launcher script. It runs the app's helper with exec, so gpg-agent talks to the helper
# directly and the helper's parent is gpg-agent. It reads files only when the helper is missing.
launcher_script() { # kind (pinentry|scdaemon) app
    say '#!/bin/sh'
    say "# touchglass-$1 launcher for gpg-agent, written by 'touchglass install', which rewrites it."
    say "# Runs the helper in TouchGlass.app; while the app is missing, runs the plain $1 instead."
    say "app=$(shq "$2")"
    say "support=$(shq "$support_dir")"
    say "helper=\"\$app/Contents/MacOS/touchglass-$1\""
    say 'if [ -x "$helper" ]; then exec "$helper" "$@"; fi'
    if [ "$1" = pinentry ]; then
        # The fallback from pinentry.conf, else pinentry-mac, else Homebrew's pinentry, which GnuPG
        # depends on: brew uninstall can remove pinentry-mac together with TouchGlass.
        say 'fallback="$(sed -n '"'"'s/^[[:space:]]*fallback-pinentry[[:space:]]*=[[:space:]]*//p'"'"' "$support/pinentry.conf" 2>/dev/null | tail -n 1 | sed '"'"'s/[[:space:]]*$//'"'"')"'
        say 'if [ -n "$fallback" ] && [ -x "$fallback" ]; then exec "$fallback" "$@"; fi'
        say "for fallback in$(default_fallbacks_quoted); do"
        say '    if [ -x "$fallback" ]; then exec "$fallback" "$@"; fi'
        say 'done'
        say 'echo "touchglass-pinentry: $helper is missing, and no fallback pinentry is executable; set fallback-pinentry in $support/pinentry.conf" >&2'
    else
        say 'real=""'
        say 'if [ -r "$support/scdaemon-program" ]; then IFS= read -r real < "$support/scdaemon-program" || true; fi'
        say 'if [ -n "$real" ] && [ -x "$real" ]; then exec "$real" "$@"; fi'
        say 'echo "touchglass-scdaemon: $helper is missing, and $support/scdaemon-program names no executable scdaemon; run touchglass install again" >&2'
    fi
    say 'exit 1'
}

# Writes a file atomically: stages it next to the target and renames it over the target, so an
# interruption leaves either the old or the new file, and gpg-agent never runs a partial launcher.
write_atomic() { # target mode source
    staged="$(mktemp "$(dirname "$1")/.touchglass.XXXXXX")"
    cat "$3" > "$staged"
    chmod "$2" "$staged"
    mv -f "$staged" "$1"
    staged=""
}

# Writes the launchers for the app and copies this script next to them.
write_launchers() { # app
    mkdir -p "$bin_dir"
    launcher_script pinentry "$1" > "$tmp_launcher"
    write_atomic "$launch_pinentry" 755 "$tmp_launcher"
    launcher_script scdaemon "$1" > "$tmp_launcher"
    write_atomic "$launch_scd" 755 "$tmp_launcher"
    if [ "$self" != "$(realpath "$cli_copy" 2>/dev/null || true)" ]; then
        write_atomic "$cli_copy" 755 "$self"
    fi
    say "Wrote the launchers for $1 to $bin_dir."
}

remove_launchers() {
    if [ -d "$bin_dir" ]; then
        rm -f "$launch_pinentry" "$launch_scd" "$cli_copy"
        rmdir "$bin_dir" 2>/dev/null || true
        rm -f "$confs_file"
        say "Removed the launchers from $bin_dir."
    fi
}

# Adds gpg-agent.conf to the list of files that can name the launchers.
record_conf() {
    if [ -f "$confs_file" ] && grep -qxF -- "$conf" "$confs_file"; then return 0; fi
    printf '%s\n' "$conf" >> "$confs_file"
}

# True if a line of the file that isn't commented out names a launcher.
names_launchers() { # file
    [ -f "$1" ] || return 1
    TG_P="$launch_pinentry" TG_S="$launch_scd" awk "$awk_lib"'
    { k = keyof($0); if (k != "") { v = valof($0); if (v == ENVIRON["TG_P"] || v == ENVIRON["TG_S"]) t = 1 } }
    END { exit t ? 0 : 1 }' "$1"
}

# When the oldest gpg-agent of this user that runs started, in seconds since the epoch, or nothing.
oldest_agent_start() {
    pids="$(pgrep -x -u "$(id -u)" gpg-agent 2>/dev/null || true)"
    [ -n "$pids" ] || return 0
    for pid in $pids; do ps -o etime= -p "$pid" 2>/dev/null || true; done | awk -v now="$(date +%s)" '
        # etime is [[dd-]hh:]mm:ss.
        NF {
            n = split($1, a, /[-:]/)
            s = a[n] + 60 * a[n - 1]
            if (n >= 3) s += 3600 * a[n - 2]
            if (n >= 4) s += 86400 * a[n - 3]
            if (max == "" || s > max) max = s
        }
        END { if (max != "") print now - max }'
}

# Why the launchers must stay, or nothing. A gpg-agent reads pinentry-program and scdaemon-program when
# it starts and runs those paths until it stops, so the launchers stay while another recorded
# gpg-agent.conf names them ("conf:<path>"), or while a gpg-agent runs that started before
# gpg-agent.conf last changed ("agent"). The caller handles the current gpg-agent.conf itself.
#
# agent_stopped is 1 when this run stopped the current home's gpg-agent. An older gpg-agent that still
# runs then belongs to another GnuPG home, whose gpg-agent.conf may have named the launchers when it
# started ("other-agent"). gpgconf --kill returns before the agent exits, so wait briefly for it.
# A dry run that would stop gpg-agent passes "dry" and skips the agent check: it can't tell the
# current home's agent apart from others.
launcher_keep_reason() { # agent_stopped (0, 1 or dry)
    if [ -f "$confs_file" ]; then
        current="$(realpath "$conf" 2>/dev/null || printf '%s' "$conf")"
        found="$(while IFS= read -r other; do
            [ -n "$other" ] && [ "$other" != "$conf" ] || continue
            [ "$(realpath "$other" 2>/dev/null || printf '%s' "$other")" != "$current" ] || continue
            if names_launchers "$other"; then printf '%s\n' "$other"; break; fi
        done < "$confs_file")"
        if [ -n "$found" ]; then printf 'conf:%s\n' "$found"; return 0; fi
    fi
    [ "$1" != dry ] || return 0
    keep=agent
    if [ "$1" = 1 ]; then keep=other-agent; fi
    tries=0
    while :; do
        started="$(oldest_agent_start)"
        [ -n "$started" ] || return 0
        if [ "$1" != 1 ] || [ "$tries" -ge 10 ] || ! older_than_conf "$started"; then break; fi
        tries=$((tries + 1))
        sleep 0.1
    done
    if older_than_conf "$started"; then echo "$keep"; fi
}

# True if a gpg-agent that started at the given time may have read an earlier gpg-agent.conf.
older_than_conf() { # started
    # Without gpg-agent.conf, nothing tells when the agent read it; keep the launchers until it stops.
    # The same if either time doesn't parse. /usr/bin/stat, because GNU stat reads -f differently.
    changed=""
    if [ -f "$conf" ]; then changed="$(/usr/bin/stat -L -f %m "$conf" 2>/dev/null || true)"; fi
    case "$1:$changed" in
        *: | *[!0-9:]*) return 0 ;;
        *) [ "$1" -le "$changed" ] ;;
    esac
}

# Removes the launchers unless a gpg-agent can still run them; then says why they stay.
remove_unused_launchers() { # agent_stopped
    [ -d "$bin_dir" ] || return 0
    reason="$(launcher_keep_reason "$1")"
    case "$reason" in
        "") remove_launchers ;;
        conf:*)
            warn "kept the launchers in $bin_dir, because ${reason#conf:} still names them. To restore that file, run '$prog uninstall' with GNUPGHOME set to its directory."
            ;;
        agent)
            warn "kept the launchers in $bin_dir, because a gpg-agent that started before $conf last changed still runs, and it runs the launchers until it stops. Stop it with 'gpgconf --kill gpg-agent', then run '$prog uninstall' again."
            ;;
        other-agent)
            warn "kept the launchers in $bin_dir, because another gpg-agent that started before $conf last changed still runs, probably for another GnuPG home, and it may run the launchers. Stop it with 'gpgconf --kill gpg-agent', with GNUPGHOME set to its directory, then run '$prog uninstall' again."
            ;;
    esac
}

# Stops gpg-agent so that it reads gpg-agent.conf again. Sets agent_stopped to 1 when it did.
agent_stopped=0
reload_agent() {
    if ! command -v gpgconf >/dev/null 2>&1; then
        warn "gpgconf not found; restart gpg-agent yourself to apply the change"
    elif gpgconf --kill gpg-agent; then
        agent_stopped=1
        say "Stopped gpg-agent with 'gpgconf --kill gpg-agent'; it restarts with the new settings on next use."
        say "gpg-agent forgot its cached PINs and passphrases, so the next card operation asks for the PIN again."
    else
        warn "gpg-agent.conf is written, but 'gpgconf --kill gpg-agent' failed; run it yourself to apply the change"
        exit_status=1
    fi
}

# After the app was replaced, the running scdaemon is still the previous touchglass-scdaemon, and it
# runs until gpg-agent stops it. gpg-agent starts it again on the next card operation.
restart_scdaemon() {
    if ! command -v gpgconf >/dev/null 2>&1; then
        warn "gpgconf not found; run 'gpgconf --kill scdaemon' yourself so that the new touchglass-scdaemon takes over"
    elif gpgconf --kill scdaemon; then
        say "Stopped scdaemon with 'gpgconf --kill scdaemon', so the next card operation runs the new touchglass-scdaemon."
        say "The card is locked again, so the next card operation asks for the PIN again."
    else
        warn "'gpgconf --kill scdaemon' failed; run it yourself so that the new touchglass-scdaemon takes over"
        exit_status=1
    fi
}

host_running() { pgrep -x TouchGlass >/dev/null 2>&1; }

show_diff() { # old new label
    if [ -f "$1" ]; then old="$1"; else old=/dev/null; fi
    diff -u -L "a/$3" -L "b/$3" "$old" "$2" || true
}

# Replaces the conf atomically: writes the new content next to it and renames it over the original, so
# an interruption leaves either the old or the new file. A symlinked conf keeps its link, and an
# existing file keeps its mode.
replace_conf() { # tmpfile
    [ -d "$gnupg_home" ] || mkdir -m 700 -p "$gnupg_home"
    target="$conf"
    if [ -L "$conf" ]; then target="$(realpath "$conf")"; fi
    staged="$(mktemp "$(dirname "$target")/.gpg-agent.conf.touchglass.XXXXXX")"
    cat "$1" > "$staged"
    # /usr/bin/stat: GNU coreutils' stat, first on PATH for some Homebrew users, reads -f differently.
    if [ -e "$target" ]; then chmod "$(/usr/bin/stat -f %Lp "$target")" "$staged"; fi
    mv -f "$staged" "$target"
    staged=""
}

cmd_install() {
    app_dir="$HOME/Applications"
    from=""
    if [ -n "$bundle_app" ]; then app_dir="$(dirname "$bundle_app")"; from="$bundle_app"; fi
    dry_run=0
    apply=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --app-dir) [ $# -ge 2 ] || die "--app-dir needs a directory"; app_dir="$2"; shift 2 ;;
            --app-dir=*) app_dir="${1#--app-dir=}"; shift ;;
            --from) [ $# -ge 2 ] || die "--from needs a path to TouchGlass.app"; from="$2"; shift 2 ;;
            --from=*) from="${1#--from=}"; shift ;;
            --apply) apply=1; shift ;;
            --dry-run) dry_run=1; shift ;;
            *) die "install: unknown option $1" ;;
        esac
    done
    case "$app_dir" in /*) ;; *) app_dir="$(pwd)/$app_dir" ;; esac
    app_dir="${app_dir%/}"
    app="$app_dir/TouchGlass.app"
    if [ "$apply" = 1 ] && [ -L "$conf" ] && ! realpath "$conf" >/dev/null 2>&1; then
        die "$conf is a symlink to $(readlink "$conf"), which doesn't exist. Create that file or remove the symlink, then run install again; nothing was written."
    fi

    # Which bundle to install, building it if it is missing or older than the sources.
    build=0
    if [ -n "$from" ]; then
        source_app="$from"
        [ -x "$source_app/Contents/MacOS/TouchGlass" ] || die "$source_app is not a TouchGlass.app"
    else
        [ -n "$repo_root" ] && [ -f "$repo_root/Package.swift" ] || die "no Package.swift next to this script; pass --from with a built TouchGlass.app"
        source_app="$repo_root/build/TouchGlass.app"
        if [ ! -f "$source_app/Contents/Info.plist" ] ||
            [ -n "$(find "$repo_root/Sources" "$repo_root/Package.swift" -newer "$source_app/Contents/Info.plist" -print 2>/dev/null | head -n 1)" ]; then
            build=1
        fi
    fi

    # The real scdaemon: the one gpg-agent.conf named before TouchGlass, else the one an earlier install
    # recorded, else the one gpgconf reports.
    real_scd="$(previous_value "$conf" scdaemon-program)"
    if [ -z "$real_scd" ] && [ -f "$scd_path_file" ]; then
        recorded="$(head -n 1 "$scd_path_file")"
        if [ -x "$recorded" ]; then real_scd="$recorded"; fi
    fi
    [ -n "$real_scd" ] || real_scd="$(gpgconf_scdaemon)"
    [ -n "$real_scd" ] || die "could not find scdaemon; is GnuPG installed and gpgconf on PATH?"
    [ -x "$real_scd" ] || warn "scdaemon at $real_scd is not executable"

    # The fallback pinentry: the one gpg-agent.conf named before TouchGlass, else pinentry-mac, else the
    # pinentry that gpgconf reports. Never a path that doesn't exist.
    fallback="$(previous_value "$conf" pinentry-program)"
    if [ -n "$fallback" ] && [ ! -x "$fallback" ]; then
        warn "gpg-agent.conf names pinentry-program $fallback, which is not executable, so it is not the fallback pinentry"
        fallback=""
    fi
    [ -n "$fallback" ] || fallback="$(find_pinentry_mac)"
    [ -n "$fallback" ] || fallback="$(gpgconf_pinentry)"
    if [ -z "$fallback" ]; then
        warn "no pinentry found; while the TouchGlass host is not reachable, PIN prompts fail. Install pinentry-mac, or set fallback-pinentry in $pinentry_conf."
    fi

    tmp="$(mktemp "${TMPDIR:-/tmp}/touchglass.XXXXXX")"
    tmp_launcher="$(mktemp "${TMPDIR:-/tmp}/touchglass.XXXXXX")"
    staged=""
    copying=0
    trap 'rm -f "$tmp" "$tmp_launcher" ${staged:+"$staged"}; if [ "$copying" = 1 ]; then rm -rf "$app.new"; fi' EXIT
    # gpg-agent.conf as --apply writes it. Without --apply, the instructions describe the same change.
    if [ -f "$conf" ]; then created=0; input="$conf"; else created=1; input=/dev/null; fi
    TG_PINENTRY="$launch_pinentry" TG_SCD="$launch_scd" TG_CREATED="$created" TG_NOEOL="$(no_eol "$input")" \
        awk "$awk_lib"'
    { L[NR] = $0; k = keyof($0); if (k != "") last[k] = NR }
    END {
        new["pinentry-program"] = ENVIRON["TG_PINENTRY"]; new["scdaemon-program"] = ENVIRON["TG_SCD"]
        keys[1] = "pinentry-program"; keys[2] = "scdaemon-program"
        if (ENVIRON["TG_CREATED"] == "1") out("# touchglass: created gpg-agent.conf")
        for (i = 1; i <= NR; i++) {
            k = keyof(L[i])
            if (k == "" || i != last[k]) { out(L[i]); continue }
            cr = (L[i] ~ /\r$/) ? "\r" : ""
            if (ours(L[i], k)) {
                if (valof(L[i]) == new[k]) out(L[i]); else out(k " " new[k] cr)
            } else {
                out("# touchglass: " L[i]); out(k " " new[k] cr)
            }
        }
        for (j = 1; j <= 2; j++) {
            k = keys[j]
            if (!(k in last)) { out("# touchglass: added " k); out(k " " new[k]) }
        }
        if (nout && ENVIRON["TG_NOEOL"] != "1") printf "\n"
    }' "$input" > "$tmp"

    conf_changed=1
    if [ -f "$conf" ] && cmp -s "$conf" "$tmp"; then conf_changed=0; fi

    # Back up only the original file: never a file TouchGlass already edited, never a second identical copy.
    backup=""
    if [ "$apply" = 1 ] && [ "$conf_changed" = 1 ] && [ -f "$conf" ] && ! touched "$conf"; then
        last_backup="$(newest_backup)"
        if [ -z "$last_backup" ] || ! cmp -s "$conf" "$last_backup"; then
            stamp="$conf.touchglass-backup-$(date +%Y%m%d-%H%M%S)"
            backup="$stamp"
            n=1
            while [ -e "$backup" ]; do backup="$stamp-$n"; n=$((n + 1)); done
        fi
    fi

    # Copy the app unless installing over the same bundle. A copy replaces the helpers that the running
    # scdaemon and host started from.
    copy_app=0
    if [ "$build" = 1 ] || [ "$(cd "$source_app" && pwd -P)" != "$( (cd "$app" 2>/dev/null && pwd -P) || true)" ]; then
        copy_app=1
    fi
    pinentry_plan="$(plan_pinentry_conf)"

    if [ "$dry_run" = 1 ]; then
        say "Dry run: nothing is written."
        if [ "$build" = 1 ]; then say "Would build TouchGlass.app with scripts/build-app.sh."; fi
        if [ "$copy_app" = 1 ]; then
            say "Would copy $source_app to $app."
            if [ "$apply" = 1 ] && host_running; then say "Would quit the running TouchGlass host with 'pkill -x TouchGlass'; the helpers start the new one on demand."; fi
        fi
        say "Would write the real scdaemon path to $scd_path_file: $real_scd"
        case "$pinentry_plan" in
            keep) say "Would keep the existing $pinentry_conf." ;;
            write) say "Would write $pinentry_conf${fallback:+ with fallback-pinentry = $fallback}." ;;
            update) say "Would update $pinentry_conf${fallback:+: fallback-pinentry = $fallback}." ;;
        esac
        say "Would write the launchers for $app to $bin_dir."
        if [ "$conf_changed" = 0 ]; then
            say "$conf already uses the TouchGlass launchers; no change."
            if [ "$copy_app" = 1 ] && [ "$apply" = 1 ]; then
                say "Would then stop scdaemon with 'gpgconf --kill scdaemon' so that the new touchglass-scdaemon takes over; the next card operation asks for the PIN again."
            fi
        elif [ "$apply" = 1 ]; then
            if [ -n "$backup" ]; then say "Would back up $conf to $backup."; fi
            say "Would change $conf:"
            show_diff "$conf" "$tmp" gpg-agent.conf
            say "Would then stop gpg-agent with 'gpgconf --kill gpg-agent', which forgets cached PINs and passphrases."
        else
            say "Would then print these instructions:"
            say ""
            print_install_steps
        fi
        return 0
    fi

    if [ "$build" = 1 ]; then
        say "Building TouchGlass.app..."
        "$repo_root/scripts/build-app.sh"
    fi

    host_quit=0
    if [ "$copy_app" = 1 ]; then
        # Copy next to the app, then swap, so a failed or interrupted copy leaves the installed app whole.
        mkdir -p "$app_dir"
        rm -rf "$app.new" "$app.old"
        copying=1
        ditto "$source_app" "$app.new" || die "could not copy $source_app; $app is unchanged"
        if [ -e "$app" ]; then mv "$app" "$app.old"; fi
        mv "$app.new" "$app"
        copying=0
        rm -rf "$app.old"
        say "Copied TouchGlass.app to $app."
        if host_running; then
            if [ "$apply" = 1 ]; then
                pkill -x TouchGlass || true
                say "Quit the running TouchGlass host with 'pkill -x TouchGlass'; the helpers start the new one on demand."
            else
                host_quit=1
            fi
        fi
    fi

    mkdir -p "$support_dir"
    chmod 700 "$support_dir"
    # Atomic, like every file that the launchers and helpers read: they run at any moment.
    printf '%s\n' "$real_scd" > "$tmp_launcher"
    write_atomic "$scd_path_file" 644 "$tmp_launcher"
    say "Wrote the real scdaemon path to $scd_path_file: $real_scd"
    write_pinentry_conf "$pinentry_plan"
    write_launchers "$app"
    record_conf

    if [ "$conf_changed" = 0 ]; then
        say "$conf already uses the TouchGlass launchers; no change."
        # gpg-agent keeps running, and so do the scdaemon and host it started from the previous copy.
        if [ "$copy_app" = 1 ]; then
            if [ "$apply" = 1 ]; then
                restart_scdaemon
            else
                say ""
                say "The running scdaemon still uses the previous touchglass-scdaemon. To switch to the new one, run:"
                if [ "$host_quit" = 1 ]; then say "  pkill -x TouchGlass"; fi
                say "  gpgconf --kill scdaemon"
                say "The card is then locked again, so the next card operation asks for the PIN again."
            fi
        fi
        return 0
    fi
    if [ "$apply" = 0 ]; then
        say ""
        print_install_steps
        if [ "$host_quit" = 1 ]; then
            say ""
            say "The TouchGlass host that runs is the previous version. To start the new one on the next prompt, run 'pkill -x TouchGlass'."
        fi
        return 0
    fi
    if [ -n "$backup" ]; then
        cp -p "$conf" "$backup"
        say "Backed up $conf to $backup."
    fi
    replace_conf "$tmp"
    say "Set pinentry-program and scdaemon-program in $conf:"
    say "  pinentry-program $launch_pinentry"
    say "  scdaemon-program $launch_scd"
    # Stopping gpg-agent stops its scdaemon too.
    reload_agent
}

# Prints how to change gpg-agent.conf by hand to what install --apply writes, markers included, so that
# either uninstall mode restores the file: which lines to keep as "# touchglass: " comments, which to
# replace (helpers named directly, from installs before the launchers) and which to add.
print_install_steps() {
    if [ -f "$conf" ]; then
        TG_PINENTRY="$launch_pinentry" TG_SCD="$launch_scd" TG_CONF="$conf" awk "$awk_lib"'
        { L[NR] = $0; sub(/\r$/, "", L[NR]); k = keyof($0); if (k != "") last[k] = NR }
        END {
            new["pinentry-program"] = ENVIRON["TG_PINENTRY"]; new["scdaemon-program"] = ENVIRON["TG_SCD"]
            keys[1] = "pinentry-program"; keys[2] = "scdaemon-program"
            for (j = 1; j <= 2; j++) {
                k = keys[j]
                if (!(k in last)) { add[++nadd] = "# touchglass: added " k; add[++nadd] = k " " new[k]; continue }
                i = last[k]
                if (ours(L[i], k)) { if (valof(L[i]) != new[k]) { edit[++nedit] = i; mark[nedit] = 0 } }
                else { edit[++nedit] = i; mark[nedit] = 1 }
            }
            if (nedit == 2 && edit[1] > edit[2]) { t = edit[1]; edit[1] = edit[2]; edit[2] = t; t = mark[1]; mark[1] = mark[2]; mark[2] = t }
            if (nedit == 2) print "Edit " ENVIRON["TG_CONF"] ". The line numbers are those before your edits:"
            else print "Edit " ENVIRON["TG_CONF"] ":"
            for (m = 1; m <= nedit; m++) {
                i = edit[m]; k = keyof(L[i])
                print ""
                if (mark[m]) {
                    printf "  Replace line %d:\n", i
                    print "    " L[i]
                    print "  with these two lines. The first keeps your line as a comment that \"touchglass uninstall\" restores:"
                    print "    # touchglass: " L[i]
                    print "    " k " " new[k]
                } else {
                    printf "  Replace line %d, which runs the helper in TouchGlass.app directly:\n", i
                    print "    " L[i]
                    print "  with this line, which runs it through the launcher:"
                    print "    " k " " new[k]
                }
            }
            if (nadd) {
                print ""
                print "  Add these lines at the end of the file. The comments tell \"touchglass uninstall\" what to remove:"
                for (m = 1; m <= nadd; m++) print "    " add[m]
            }
        }' "$conf"
    else
        say "Create $conf with these lines. The comments tell \"$prog uninstall\" what to remove:"
        say "    # touchglass: created gpg-agent.conf"
        say "    # touchglass: added pinentry-program"
        say "    pinentry-program $launch_pinentry"
        say "    # touchglass: added scdaemon-program"
        say "    scdaemon-program $launch_scd"
    fi
    say ""
    say "Then stop gpg-agent so that it reads the file on next use:"
    say "    gpgconf --kill gpg-agent"
    say "gpg-agent forgets its cached PINs and passphrases, so the next card operation asks for the PIN again."
    say ""
    say "To have $prog make this change for you, run '$prog install --apply'. It backs up gpg-agent.conf first, and '$prog uninstall --apply' reverts it."
}

# What install does with pinentry.conf: "write" a new file, "update" the installer's lines in the
# existing one, or "keep" it as it is.
plan_pinentry_conf() {
    if [ ! -f "$pinentry_conf" ]; then echo write; return; fi
    # Earlier installs wrote host-app with the app's path. The helpers start the app they are in, so
    # the line can only go stale.
    if grep -q '^host-app = /.*/TouchGlass\.app$' "$pinentry_conf"; then echo update; return; fi
    # A fallback that no longer exists is replaced; one that works is the user's choice and stays.
    current="$(pinentry_setting fallback-pinentry)"
    if [ -n "$fallback" ] && { [ -z "$current" ] || [ ! -x "$current" ]; }; then echo update; return; fi
    echo keep
}

# The value of a key in pinentry.conf, or nothing.
pinentry_setting() { # key
    [ -f "$pinentry_conf" ] || return 0
    TG_KEY="$1" awk '
        { line = $0; sub(/^[ \t]+/, "", line) }
        index(line, ENVIRON["TG_KEY"]) == 1 {
            rest = substr(line, length(ENVIRON["TG_KEY"]) + 1)
            if (rest ~ /^[ \t]*=/) { sub(/^[ \t]*=[ \t]*/, "", rest); sub(/[ \t]+$/, "", rest); v = rest }
        }
        END { print v }' "$pinentry_conf"
}

write_pinentry_conf() { # plan
    case "$1" in
        keep)
            say "Kept the existing $pinentry_conf."
            ;;
        write)
            {
                echo '# touchglass-pinentry settings. One "key = value" per line.'
                echo '# The pinentry that takes over when the TouchGlass host is not reachable.'
                if [ -n "$fallback" ]; then echo "fallback-pinentry = $fallback"; else echo "# fallback-pinentry = /path/to/pinentry-mac"; fi
            } > "$tmp_launcher"
            write_atomic "$pinentry_conf" 644 "$tmp_launcher"
            say "Wrote $pinentry_conf${fallback:+ with fallback-pinentry = $fallback}."
            ;;
        update)
            staged="$(mktemp "$support_dir/.pinentry.conf.XXXXXX")"
            TG_FALLBACK="$fallback" awk '
                /^# The app the pinentry starts when the host is not running/ { next }
                /^host-app = \/.*\/TouchGlass\.app$/ { next }
                /^[ \t]*fallback-pinentry[ \t]*=/ && ENVIRON["TG_FALLBACK"] != "" {
                    if (!done) print "fallback-pinentry = " ENVIRON["TG_FALLBACK"]
                    done = 1; next
                }
                { print }
                END { if (!done && ENVIRON["TG_FALLBACK"] != "") print "fallback-pinentry = " ENVIRON["TG_FALLBACK"] }' "$pinentry_conf" > "$staged"
            mv -f "$staged" "$pinentry_conf"
            staged=""
            say "Updated $pinentry_conf${fallback:+: fallback-pinentry = $fallback}."
            ;;
    esac
}

cmd_uninstall() {
    remove_app=0
    dry_run=0
    apply=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply) apply=1; shift ;;
            --remove-app) remove_app=1; shift ;;
            --dry-run) dry_run=1; shift ;;
            --check) [ $# -eq 1 ] || die "--check takes no other options"; check_unused; return 0 ;;
            *) die "uninstall: unknown option $1" ;;
        esac
    done

    app="$(app_from_conf)"
    [ -n "$app" ] || app="$(launcher_app "$launch_pinentry")"
    [ -n "$app" ] || app="$default_app"
    if [ "$remove_app" = 1 ]; then
        case "$(realpath "$app" 2>/dev/null || printf '%s' "$app")" in
            */Cellar/*) die "Homebrew installed $app; remove it with 'brew uninstall touchglass' instead of --remove-app. Nothing was changed." ;;
        esac
    fi

    tmp="$(mktemp "${TMPDIR:-/tmp}/touchglass.XXXXXX")"
    notes="$(mktemp "${TMPDIR:-/tmp}/touchglass.XXXXXX")"
    staged=""
    trap 'rm -f "$tmp" "$notes" ${staged:+"$staged"}' EXIT

    conf_changed=0
    if [ -f "$conf" ]; then
        # Lines to restore when a TouchGlass line has no marker: the option's last line in the newest backup.
        backup="$(newest_backup)"
        fb_p=""; fb_s=""
        if [ -n "$backup" ]; then
            fb_p="$(TG_KEY=pinentry-program awk "$awk_lib"'keyof($0) == ENVIRON["TG_KEY"] && !ours($0, ENVIRON["TG_KEY"]) { l = $0 } END { if (l != "") print l }' "$backup")"
            fb_s="$(TG_KEY=scdaemon-program awk "$awk_lib"'keyof($0) == ENVIRON["TG_KEY"] && !ours($0, ENVIRON["TG_KEY"]) { l = $0 } END { if (l != "") print l }' "$backup")"
        fi
        TG_HAVE_BACKUP="$([ -n "$backup" ] && echo 1 || echo 0)" TG_FB_P="$fb_p" TG_FB_S="$fb_s" \
            TG_NOEOL="$(no_eol "$conf")" TG_NOTES="$notes" awk "$awk_lib"'
        { L[NR] = $0 }
        END {
            fb["pinentry-program"] = ENVIRON["TG_FB_P"]; fb["scdaemon-program"] = ENVIRON["TG_FB_S"]
            notes = ENVIRON["TG_NOTES"]
            i = 1
            while (i <= NR) {
                line = L[i]
                if (index(line, "# touchglass: ") == 1) {
                    body = substr(line, 15)
                    if (body == "created gpg-agent.conf") { print "created" > notes; i++; continue }
                    if (body ~ /^added (pinentry|scdaemon)-program$/) { k = substr(body, 7); orig = ""; restore = 0 }
                    else { k = keyof(body); orig = body; restore = 1 }
                    if (k != "" && i < NR && keyof(L[i + 1]) == k && ours(L[i + 1], k)) {
                        if (restore) out(orig)
                        i += 2; continue
                    }
                    print "orphan " line > notes
                    out(line); i++; continue
                }
                k = keyof(line)
                if (k != "" && ours(line, k)) {
                    if (fb[k] != "") { out(fb[k]); print "from-backup " k > notes }
                    else {
                        bare[k] = 1
                        if (ENVIRON["TG_HAVE_BACKUP"] == "1") print "removed-per-backup " k > notes
                        else print "removed-no-backup " k > notes
                    }
                    i++; continue
                }
                out(line); i++
            }
            if (nout && ENVIRON["TG_NOEOL"] != "1") printf "\n"
            # A commented-out line for an option whose TouchGlass line has no marker might be the earlier
            # setting, commented out by hand. Only the user can tell.
            for (i = 1; i <= NR; i++) {
                if (index(L[i], "# touchglass: ") == 1 || L[i] !~ /^[ \t]*#/) continue
                t = L[i]; sub(/^[ \t]*#[ \t]*/, "", t)
                k = keyof(t)
                if (k != "" && (k in bare) && !ours(t, k) && !(k in told)) { print "ambiguous " k > notes; told[k] = 1 }
            }
        }' "$conf" > "$tmp"
        if ! cmp -s "$conf" "$tmp"; then conf_changed=1; fi
    fi

    delete_conf=0
    if grep -qx created "$notes" && [ ! -s "$tmp" ]; then delete_conf=1; fi

    explain_notes() { # verb prefix ("Would " or "")
        while IFS= read -r note; do
            case "$note" in
                "from-backup "*) say "No marker for ${note#from-backup }; $1restore it from $backup." ;;
                "removed-per-backup "*) say "No marker for ${note#removed-per-backup }; $backup does not set it, so $1remove the TouchGlass line." ;;
                "removed-no-backup "*) warn "no marker and no backup for ${note#removed-no-backup }; $1remove the TouchGlass line, so gpg-agent uses its default." ;;
                "orphan "*) warn "kept '${note#orphan }': the line after it is not a TouchGlass line" ;;
            esac
        done < "$notes"
    }

    # What dry runs say about the launchers.
    would_launchers() { # agent_stopped
        [ -d "$bin_dir" ] || return 0
        case "$(launcher_keep_reason "$1")" in
            "") say "Would remove the launchers from $bin_dir." ;;
            conf:*) say "Would keep the launchers in $bin_dir, because $(launcher_keep_reason "$1" | sed 's/^conf://') still names them." ;;
            agent) say "Would keep the launchers in $bin_dir, because a gpg-agent that started before $conf last changed still runs." ;;
        esac
    }

    if [ "$apply" = 0 ]; then
        if conf_refers; then
            if [ "$dry_run" = 1 ]; then say "Dry run: nothing is written."; fi
            print_uninstall_steps
            if [ "$remove_app" = 1 ]; then say "Kept $app, because gpg-agent.conf still uses it."; fi
            return 0
        fi
        if [ "$dry_run" = 1 ]; then
            say "Dry run: nothing is written."
            say "$conf doesn't use TouchGlass."
            would_launchers 0
            if [ "$remove_app" = 1 ]; then say "Would remove $app."; fi
            return 0
        fi
        say "$conf doesn't use TouchGlass."
        remove_unused_launchers 0
        report_kept
        remove_installed_app
        return 0
    fi

    # A TouchGlass line without a marker, next to a commented-out line for the same option: the file was
    # edited by hand, and the commented-out line may or may not be the earlier setting. Change nothing.
    if grep -q '^ambiguous ' "$notes"; then
        {
            for key in $(sed -n 's/^ambiguous //p' "$notes"); do
                say "$prog: $conf has a TouchGlass $key line without the \"# touchglass: \" comment that records your earlier line, and a commented-out $key line that may be it."
            done
            say "$prog: uninstall --apply can't tell what to restore, so it changed nothing. Edit the file yourself:"
            say ""
            print_uninstall_steps
        } >&2
        exit 1
    fi

    if [ "$dry_run" = 1 ]; then
        say "Dry run: nothing is written."
        explain_notes "would "
        if [ "$conf_changed" = 1 ]; then
            say "Would change $conf:"
            if [ "$delete_conf" = 1 ]; then
                show_diff "$conf" /dev/null gpg-agent.conf
                say "Would delete $conf, which install created."
            else
                show_diff "$conf" "$tmp" gpg-agent.conf
            fi
            say "Would then stop gpg-agent with 'gpgconf --kill gpg-agent', which forgets cached PINs and passphrases."
        else
            say "$conf has no TouchGlass lines; no change."
        fi
        if [ "$conf_changed" = 1 ] && [ -d "$bin_dir" ] && ! command -v gpgconf >/dev/null 2>&1; then
            say "Would keep the launchers in $bin_dir, because without gpgconf uninstall can't stop gpg-agent."
        else
            if [ "$conf_changed" = 1 ]; then would_launchers dry; else would_launchers 0; fi
        fi
        if [ "$remove_app" = 1 ]; then say "Would remove $app."; fi
        return 0
    fi

    explain_notes ""
    if [ "$conf_changed" = 1 ]; then
        if [ "$delete_conf" = 1 ]; then
            rm -f "$conf"
            say "Removed $conf, which install created."
        else
            replace_conf "$tmp"
            say "Restored pinentry-program and scdaemon-program in $conf."
        fi
        reload_agent
    else
        say "$conf has no TouchGlass lines; no change."
    fi
    # Remove the launchers only after gpg-agent stopped using them: a running gpg-agent keeps the
    # paths it read at start.
    if [ ! -d "$bin_dir" ]; then
        :
    elif [ "$exit_status" != 0 ]; then
        warn "kept the launchers in $bin_dir, because gpg-agent may still run them; run '$prog uninstall' again after you stopped gpg-agent"
    elif [ "$conf_changed" = 1 ] && [ "$agent_stopped" = 0 ]; then
        warn "kept the launchers in $bin_dir, because without gpgconf uninstall couldn't stop gpg-agent, which runs them until it stops. Stop gpg-agent, then run '$prog uninstall' again."
    else
        remove_unused_launchers "$agent_stopped"
    fi
    report_kept
    remove_installed_app
}

# Tells what uninstall leaves behind on purpose.
report_kept() {
    if ls "$conf".touchglass-backup-* >/dev/null 2>&1; then
        say "Kept the backups of gpg-agent.conf next to it."
    fi
    if [ -d "$support_dir" ]; then
        say "Kept $support_dir, which holds the pinentry settings, the real scdaemon path and host.conf; remove it yourself if you don't reinstall."
    fi
}

remove_installed_app() {
    [ "$remove_app" = 1 ] || return 0
    if [ -x "$app/Contents/MacOS/TouchGlass" ] && [ "${app##*/}" = TouchGlass.app ]; then
        rm -rf "$app"
        say "Removed $app."
        if host_running; then say "The TouchGlass host is still running; quit it with 'pkill -x TouchGlass'."; fi
    else
        say "No TouchGlass.app at $app; nothing to remove."
    fi
}

# Prints how to restore gpg-agent.conf by hand: the lines to put back from "# touchglass: " markers,
# the TouchGlass lines to delete, and commented-out lines that might hold the earlier setting.
print_uninstall_steps() {
    if [ "$delete_conf" = 1 ]; then
        say "Delete $conf: '$prog install --apply' created it, and it holds nothing else."
    else
        TG_CONF="$conf" awk "$awk_lib"'
        { L[NR] = $0; sub(/\r$/, "", L[NR]) }
        END {
            for (i = 1; i <= NR; i++) {
                line = L[i]
                if (index(line, "# touchglass: ") == 1) {
                    body = substr(line, 15)
                    if (body == "created gpg-agent.conf") { del[++ndel] = i; continue }
                    if (body ~ /^added (pinentry|scdaemon)-program$/) { k = substr(body, 7); orig = "" }
                    else { k = keyof(body); orig = body }
                    if (k != "" && i < NR && keyof(L[i + 1]) == k && ours(L[i + 1], k)) {
                        if (orig != "") { repl[++nrepl] = i; with[nrepl] = orig }
                        else { del[++ndel] = i; del[++ndel] = i + 1 }
                        i++
                    }
                    continue
                }
                k = keyof(line)
                if (k != "" && ours(line, k)) { del[++ndel] = i; bare[k] = 1 }
            }
            # Commented-out lines for an option whose TouchGlass line has no marker.
            for (i = 1; i <= NR; i++) {
                if (index(L[i], "# touchglass: ") == 1 || L[i] !~ /^[ \t]*#/) continue
                t = L[i]; sub(/^[ \t]*#[ \t]*/, "", t)
                k = keyof(t)
                if (k != "" && (k in bare) && !ours(t, k)) cand[++ncand] = i
            }
            print "Edit " ENVIRON["TG_CONF"] ":"
            for (m = 1; m <= nrepl; m++) {
                i = repl[m]
                print ""
                printf "  Replace lines %d and %d:\n", i, i + 1
                print "    " L[i]
                print "    " L[i + 1]
                print "  with the line TouchGlass replaced:"
                print "    " with[m]
            }
            if (ndel) {
                print ""
                print "  Delete these lines:"
                for (m = 1; m <= ndel; m++) printf "    line %d: %s\n", del[m], L[del[m]]
            }
            if (ncand) {
                print ""
                print "  If you commented out your earlier setting, remove the \"#\" from it again:"
                for (m = 1; m <= ncand; m++) printf "    line %d: %s\n", cand[m], L[cand[m]]
            }
        }' "$conf"
    fi
    say ""
    say "Then stop gpg-agent so that it reads the file on next use:"
    say "    gpgconf --kill gpg-agent"
    say "gpg-agent forgets its cached PINs and passphrases, so the next card operation asks for the PIN again."
    say ""
    if [ -d "$bin_dir" ]; then
        say "The launchers in $bin_dir stay in place while gpg-agent.conf names them, because gpg-agent runs them for every PIN prompt and card operation. After you changed the file and stopped gpg-agent, run '$prog uninstall' again to remove them."
        say ""
    fi
    say "To have $prog make this change for you, run '$prog uninstall --apply'."
}

# Checks before TouchGlass's files are deleted: fails while gpg-agent.conf or the launchers still refer
# to TouchGlass. The launchers count too, because a gpg-agent.conf in another GnuPG home can name them,
# and a command run without that GNUPGHOME doesn't see it.
check_unused() {
    if conf_refers; then
        {
            say "$prog: $conf still runs TouchGlass:"
            awk "$awk_lib"'{ k = keyof($0); if (k != "" && ours($0, k)) printf "  line %d: %s\n", NR, $0 }' "$conf"
            say "Removing TouchGlass now leaves gpg-agent without its pinentry and scdaemon. Run '$prog uninstall' to see how to restore the original lines, or '$prog uninstall --apply' to restore them for you. Then remove TouchGlass again."
        } >&2
        exit 1
    fi
    if [ -e "$launch_pinentry" ] || [ -e "$launch_scd" ]; then
        {
            say "$prog: the TouchGlass launchers in $bin_dir are still installed."
            say "$conf doesn't name them, but a gpg-agent.conf in another GnuPG home might. Run '$prog uninstall' with GNUPGHOME set as you use it; it removes the launchers when that gpg-agent.conf doesn't name them. Then remove TouchGlass again."
        } >&2
        exit 1
    fi
    say "gpg-agent.conf doesn't use TouchGlass, and no launchers are installed."
}

cmd_status() {
    [ $# -eq 0 ] || die "status takes no options"
    say "GnuPG home:        $gnupg_home"
    if [ -f "$conf" ]; then
        p="$(current_value "$conf" pinentry-program)"
        s="$(current_value "$conf" scdaemon-program)"
    else
        say "gpg-agent.conf:    missing"
        p=""; s=""
    fi
    label() { # value helper-name launcher
        if [ -z "$1" ]; then printf '(not set; gpg-agent default)'
        else
            printf '%s' "$1"
            case "$1" in
                "$3") printf ' (TouchGlass launcher%s)' "$([ -x "$1" ] || echo ', missing')" ;;
                */"$2") printf ' (TouchGlass helper%s)' "$([ -x "$1" ] || echo ', missing')" ;;
            esac
        fi
    }
    say "pinentry-program:  $(label "$p" touchglass-pinentry "$launch_pinentry")"
    say "scdaemon-program:  $(label "$s" touchglass-scdaemon "$launch_scd")"
    case "$(conf_mode)" in
        launchers) say "Setup:             gpg-agent.conf runs TouchGlass through the launchers" ;;
        direct) say "Setup:             gpg-agent.conf runs the helpers in TouchGlass.app directly, as older installs did; run '$prog install' to see how to switch to the launchers, which keep working while Homebrew upgrades the app" ;;
        mixed) say "Setup:             gpg-agent.conf runs TouchGlass for one option only; run '$prog install' to see the lines to set" ;;
        none) say "Setup:             gpg-agent.conf doesn't use TouchGlass; run '$prog install' to see how to connect it" ;;
    esac

    launched="$(launcher_app "$launch_pinentry")"
    if [ -n "$launched" ]; then
        if [ -x "$launched/Contents/MacOS/touchglass-pinentry" ]; then
            say "Launchers:         $bin_dir, running $launched"
        else
            say "Launchers:         $bin_dir, running the fallbacks, because $launched is missing"
        fi
    else
        say "Launchers:         not installed"
    fi

    app="$(app_from_conf)"
    [ -n "$app" ] || app="${launched:-$default_app}"
    if [ -d "$app" ]; then
        version="$(plutil -extract CFBundleShortVersionString raw -o - "$app/Contents/Info.plist" 2>/dev/null || echo unknown)"
        say "App:               $app (version $version)"
    else
        say "App:               not found at $app"
    fi
    if host_running; then say "Host:              running"; else say "Host:              not running"; fi
    # A scdaemon that gpg-agent started while the app was missing, such as during brew upgrade, is the
    # real one, and it shows no panel until it stops.
    if pgrep -x -u "$(id -u)" touchglass-scdaemon >/dev/null 2>&1; then
        say "scdaemon proxy:    running"
    elif pgrep -x -u "$(id -u)" scdaemon >/dev/null 2>&1; then
        say "scdaemon proxy:    not running; scdaemon runs without it, so card operations show no panel. Run 'gpgconf --kill scdaemon'; the next card operation starts it through the launcher."
    else
        say "scdaemon proxy:    not running; gpg-agent starts it with the next card operation"
    fi
    if [ -f "$scd_path_file" ]; then say "Real scdaemon:     $(head -n 1 "$scd_path_file")"; else say "Real scdaemon:     not configured"; fi
    if [ -n "$launched" ] || [ -f "$pinentry_conf" ]; then
        fb="$(pinentry_setting fallback-pinentry)"
        effective="$(effective_fallback)"
        if [ -z "$effective" ]; then
            say "Fallback pinentry: none executable; while the host isn't reachable or TouchGlass.app is missing, PIN prompts fail. Install pinentry-mac, or set fallback-pinentry in $pinentry_conf."
        elif [ -n "$fb" ] && [ "$fb" != "$effective" ]; then
            say "Fallback pinentry: $effective, because $fb is missing"
        else
            say "Fallback pinentry: $effective"
        fi
    fi
    backups="$(ls -1 "$conf".touchglass-backup-* 2>/dev/null | LC_ALL=C sort || true)"
    if [ -n "$backups" ]; then
        say "Backups:"
        printf '%s\n' "$backups" | sed 's/^/  /'
    else
        say "Backups:           none"
    fi
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
command="$1"; shift
case "$command" in
    install) cmd_install "$@"; exit "$exit_status" ;;
    uninstall) cmd_uninstall "$@"; exit "$exit_status" ;;
    status) cmd_status "$@" ;;
    version | --version) say "$prog $cli_version" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
